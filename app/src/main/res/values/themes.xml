<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Official Android 12+ SplashScreen Theme (androidx.core:core-splashscreen) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#07152F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>

    <!-- Backwards-compatible alias -->
    <style name="Theme.OmniChurch.Splash" parent="Theme.App.Starting" />

    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#07152F</item>
        <item name="android:statusBarColor">#07152F</item>
        <item name="android:navigationBarColor">#07152F</item>
    </style>
</resources>
